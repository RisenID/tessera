    <!-- Setup checklist -->
    <string name="setup_title">Setup</string>
    <string name="setup_body">Each permission unlocks one feature on your computer. Nothing is sent anywhere else.</string>

    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Mirror notifications, reply to them, and read one‑time passcodes.</string>
    <string name="perm_dnd">Do Not Disturb</string>
    <string name="perm_dnd_why">Silence both screens together.</string>
    <string name="perm_messages">Messages</string>
    <string name="perm_messages_why">Read and send texts from your computer.</string>
    <string name="perm_calls">Calls</string>
    <string name="perm_calls_why">See recent calls, and answer and place calls from your computer.</string>
    <string name="perm_contacts">Contacts</string>
    <string name="perm_contacts_why">Search your contacts and call them from your computer, and see names on calls and texts.</string>
    <string name="perm_photos">Photos</string>
    <string name="perm_photos_why">Browse your gallery and save photos across.</string>
    <string name="perm_camera">Camera</string>
    <string name="perm_camera_why">Use this phone as a webcam.</string>
    <string name="perm_projection">Audio without asking</string>
    <string name="perm_projection_why">Let your computer start the audio on its own, instead of Android asking on this phone every time. Needs Shizuku; granted once, and reversible.</string>
    <string name="perm_audio">Microphone</string>
    <string name="perm_audio_why">Play this phone\'s audio on your computer, and use this phone as the computer\'s microphone when you ask for that. Android requires the permission for playback capture either way.</string>

    <!-- Hotspot -->
    <string name="hotspot_title">One‑click hotspot</string>
    <string name="hotspot_body">Android only lets system apps switch tethering on. Shizuku lends this app shell access so your computer can do it without you touching the phone.</string>
    <string name="shizuku_connect">Connect to Shizuku</string>
    <string name="shizuku_ready">Ready — one‑click hotspot available</string>
    <string name="shizuku_needs_permission">Installed, but needs permission</string>
    <string name="shizuku_missing">Not running — the hotspot panel will open instead</string>

