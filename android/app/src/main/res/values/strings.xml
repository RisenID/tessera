    <!-- Setup checklist -->
    <string name="setup_title">Setup</string>
    <string name="setup_body">Each permission unlocks one feature on your computer. Nothing is sent anywhere else.</string>

    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Mirror notifications, reply to them, and read one‑time passcodes.</string>
    <string name="perm_dnd">Do Not Disturb</string>
    <string name="perm_dnd_why">Silence both screens together.</string>
    <string name="perm_messages">Messages</string>
    <string name="perm_messages_why">Read and send texts from your computer.</string>
    <string name="perm_photos">Photos</string>
    <string name="perm_photos_why">Browse your gallery and save photos across.</string>
    <string name="perm_camera">Camera</string>
    <string name="perm_camera_why">Use this phone as a webcam.</string>
    <string name="perm_projection">Audio without asking</string>
    <string name="perm_projection_why">Let your computer start the audio on its own, instead of Android asking on this phone every time. Needs Shizuku; granted once, and reversible.</string>
    <string name="perm_audio">Microphone</string>
    <string name="perm_audio_why">Play this phone\'s audio on your computer. The microphone itself is never opened — Android requires the permission to capture what is playing.</string>

