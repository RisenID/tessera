<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+). Without this, queryIntentActivities
         returns a filtered list and the desktop's app launcher would be missing
         most apps. Asking only for launcher activities keeps the scope narrow;
         QUERY_ALL_PACKAGES is neither needed nor justifiable here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required to start a foregroundServiceType="connectedDevice" service:
         the platform demands FOREGROUND_SERVICE_CONNECTED_DEVICE *plus* one of
         a set of connectivity permissions, and ACCESS_WIFI_STATE is not one of
         them. Multicast is the honest choice here: the service advertises
         itself over mDNS so the desktop can find it without a typed-in IP. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Since Android 9 a background app cannot open the camera. Streaming the
         webcam therefore needs the service to also run as a camera foreground
         service for as long as the stream lasts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Sending what the phone is playing to the desktop. Playback capture is
         gated behind a MediaProjection, so the service must also be a
         mediaProjection foreground service while a stream is live. RECORD_AUDIO
         is required by AudioRecord even though the microphone is never opened:
         the source is the phone's own media mix, a copy of it, which is why
         this cannot take audio away from the phone's headphones. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Reading and setting the interruption filter. Granted by the user in
         Settings; this is what removes the need to poll over adb. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- SMS needs telephony hardware, but the app is still useful without it
         (photos, notifications, screen), so it must not be a hard requirement. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Calls. ANSWER_PHONE_CALLS covers answering and hanging up and is an
         ordinary runtime permission, so call control needs no privileged
         access. CALL_PHONE only decides whether dialling happens immediately
         or opens the dialer with the number ready. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- The phone's storage as a folder on the desktop. Android 11 and later
         show an app the whole of shared storage only with "All files access";
         it is granted in Settings, or through Shizuku from the desktop, and
         nothing else in the app needs it. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Companion association. Beyond being the honest description of what this
         app is, it keeps the service alive in the background without a battery
         exemption prompt, and is the category Google names as exempt from the
         Android 17 SMS OTP delay. -->
    <uses-feature android:name="android.software.companion_device_setup" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tessera">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- No launcher entry, no history, never in Recents: it exists only to
             hold the projection request for a moment. -->
        <!-- Exported only so the shell can start it, which is what makes the
             audio start without the phone being touched. It answers nothing
             without the single-use token the service issues, so an app that
             starts it achieves exactly nothing. -->
        <activity
            android:name=".ConsentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tessera.Invisible" />

        <!-- "Share to Tessera" from any app on the phone. No interface: it
             hands what it was given to the connected desktops and closes.
             Exported because that is what a share target is. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/share_label"
            android:theme="@style/Theme.Tessera.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".TesseraService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|camera|mediaProjection" />

        <!-- Shizuku hands the app a shell-UID binder through this provider. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Clipboard sharing without Shizuku; the user switches it on under
             Accessibility, and it survives a reboot. -->
        <service
            android:name=".features.ClipboardAccessibility"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_clipboard" />
        </service>

        <service
            android:name=".features.NotificationBridge"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
