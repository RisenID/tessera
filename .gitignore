# Byte-compiled Python. Nothing here is worth versioning, and with no commits
# yet a first `git add` would otherwise sweep it all in.
__pycache__/
*.py[cod]

# Build output lives outside the checkout by design -- see scripts/android-env.sh
# and settings.gradle.kts -- so these only catch a stray invocation that
# bypasses the scripts.
/build/
*.rpm
*.apk

# The Windows build: PyInstaller's output and the icon it draws on the way.
/dist/
/packaging/windows/tessera.ico

# Machine-specific, generated by setup.
local.properties
.idea/
.vscode/
